# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Postgres connection (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thebook_dev

# Sign-in verification: set ONE of these.
# Projects on Supabase's asymmetric JWT signing keys:
SUPABASE_URL=https://your-project-ref.supabase.co
# Projects still on the legacy shared secret (Project Settings > API > JWT secret):
# SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser on another
# domain, e.g. the Cloudflare Pages URL. Leave empty if served from the same origin.
ALLOWED_ORIGINS=

PORT=8787

# Integration tests only; the database name must end in _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thebook_test
